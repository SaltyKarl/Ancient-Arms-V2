	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="12GaugeChargedBase">
		<defName>Ammo_12GaugeCharged_NE</defName>
		<label>12 gauge charged (N.E)</label>
		<graphicData>
			<texPath>Things/Ammo/Charged/Embed/M</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<Mass>0.043</Mass>
		</statBases>
		<ammoClass>AW_NanoExplosive</ammoClass>
		<generateAllowChance>0</generateAllowChance>
	</ThingDef>

	<ThingDef Class="CombatExtended.AmmoDef" ParentName="12GaugeChargedBase">
