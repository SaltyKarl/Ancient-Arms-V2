	<!-- ================== Projectiles ================== -->

	<ThingDef ParentName="Base12GaugeChargedBullet">
		<defName>Bullet_12GaugeCharged_NE</defName>
		<label>charge shot (N.E)</label>
		<graphicData>
			<drawSize>(1.5,1.5)</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>24</damageAmountBase>
			<secondaryDamage>
				<li>
					<def>AW_NanoExplosive</def>
					<amount>15</amount>
				</li>
			</secondaryDamage>
			<armorPenetrationSharp>15</armorPenetrationSharp>
			<armorPenetrationBlunt>90</armorPenetrationBlunt>
			<effectiveRangeMultiplier>1.5</effectiveRangeMultiplier>
			<recoilMultiplier>2.00</recoilMultiplier>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base12GaugeChargedBullet">
		<defName>Bullet_12GaugeCharged_CM</defName>
		<label>charge shot pellet (NANO)</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>8</damageAmountBase>
			<secondaryDamage>
				<li>
					<def>AW_AcidMechanites</def>
					<amount>1</amount>
				</li>
			</secondaryDamage>
			<armorPenetrationSharp>10</armorPenetrationSharp>
			<armorPenetrationBlunt>14.4</armorPenetrationBlunt>
			<pelletCount>6</pelletCount>
			<spreadMult>8.9</spreadMult>
			<shieldDamageMultiplier>0.10</shieldDamageMultiplier>
		</projectile>
	</ThingDef>

