	<ThingDef Class="CombatExtended.AmmoDef" ParentName="20x105mmChargedBase">
		<defName>Ammo_20x105mmCharged_NE</defName>
		<label>20x105mm Charged (N.E)</label>
		<graphicData>
			<texPath>Things/Ammo/Charged/Embed/L</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<ammoClass>AW_NanoExplosive</ammoClass>
