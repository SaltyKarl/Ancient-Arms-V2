	<!-- ================== Projectiles ================== -->

	<ThingDef ParentName="Base20x105mmChargedBullet">
		<defName>Bullet_20x105mmCharged_NE</defName>
		<label>20x105mm Charged bullet (N.E)</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>58</damageAmountBase>
			<armorPenetrationSharp>40</armorPenetrationSharp>
			<armorPenetrationBlunt>1210</armorPenetrationBlunt>
			<secondaryDamage>
				<li>
					<def>AW_NanoExplosive</def>
					<amount>22</amount>
				</li>
			</secondaryDamage>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="Base20x105mmChargedBullet">
